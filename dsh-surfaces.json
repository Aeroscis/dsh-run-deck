{
  "$comment": "本插件依赖的宿主接口。scripts/compat-probe.mjs 读这份清单，去宿主产物里逐项确认还在不在；宿主升级后只说变了什么，不重新推导一遍依赖。新增对宿主接口的调用时，把服务名和方法加进来。",
  "host": {
    "services": [
      {
        "name": "webServer",
        "members": [
          "register"
        ],
        "why": "src/routes.ts 注册 /dsh-run-deck/api/* 端点"
      },
      {
        "name": "commands",
        "members": [
          "register"
        ],
        "why": "src/host.ts 注册 /run-deck 命令"
      },
      {
        "name": "tools",
        "members": [
          "register"
        ],
        "why": "src/tool.ts 把跑配置注册成模型可见工具"
      },
      {
        "name": "subprocess",
        "members": [
          "spawnTerminal"
        ],
        "why": "src/exec.ts 跑、停、重跑条目；方法实现在 dsh-subprocess-local，dsh-subprocess 只是底座",
        "implementedBy": [
          "dsh-subprocess-local"
        ]
      }
    ],
    "packages": [
      "dsh-tools",
      "dsh-host-webserver",
      "dsh-subprocess"
    ],
    "providerPackages": [
      "dsh-host-webserver",
      "dsh-commands",
      "dsh-tools",
      "dsh-subprocess-local"
    ]
  },
  "client": {
    "services": [
      {
        "name": "slots",
        "members": [
          "inject",
          "register"
        ],
        "why": "src/client.tsx 注册对话输入区下方的运行配置栏"
      },
      {
        "name": "sessions",
        "members": [
          "get"
        ],
        "why": "从会话的 cwd 找到对应项目的 run.json"
      }
    ],
    "slots": [
      "conversation.input.dock"
    ],
    "packages": [
      "dsh-client-ui-conversation"
    ],
    "providerPackages": [
      "dsh-client-ui-renderer",
      "dsh-session"
    ]
  }
}
